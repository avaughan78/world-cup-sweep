# Neon database connection string
# Get from: console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# football-data.org API key (free tier covers World Cup)
# Sign up at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_key_here

# Secret used to authenticate POST /api/sync calls
# Choose anything random, e.g. openssl rand -hex 32
SYNC_SECRET=change_me_to_something_secret

# Password for the /admin page
ADMIN_PASSWORD=change_me

# Google Sheets published CSV URL
# In Google Sheets: File → Share → Publish to web → CSV → copy link
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?output=csv

# Football season to pull data for (default: 2026)
# Set to 2022 in .env.local to test against the completed Qatar World Cup
FOOTBALL_SEASON=2026

# Resend API key — for the bug report form
# Get from: resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# YouTube URL for the trophy easter egg (100 World Cup Goals)
# Paste any YouTube watch URL — it will be converted to an embed automatically
NEXT_PUBLIC_TROPHY_VIDEO_URL=
